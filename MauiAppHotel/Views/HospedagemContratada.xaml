<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
        <Label 
            Text="Suíte master"
            TextColor="#D3AF37"
            FontFamily="BricolageGrotesque_SemiCondensed - Bold"
            FontSize="33"
            HorizontalTextAlignment="Center" />

        <Frame Margin="10">
            <VerticalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos:" />
                    <Label Text="2"
                           TextColor="#D3AF37" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Crianças:" />
                    <Label Text="2"
                           TextColor="#D3AF37" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="check-in:"/>
                <Label Grid.Row="0" Grid.Column="1" Text="check-out:"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:"/>

                <Label Grid.Row="1" Grid.Column="0" Text="check-in:"/>
                <Label Grid.Row="1" Grid.Column="1" Text="check-out:"/>
                <Label Grid.Row="1" Grid.Column="2" Text="Estadia:"/>
            </Grid>


        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total:" />
                <Label Text="R$ 25,25" />

            </HorizontalStackLayout>
        </Frame>

        <Button 
            Text="Voltar"
            BackgroundColor="#D3AF37"
            TextColor="White"
            FontFamily="BricolageGrotesque_SemiCondensed - Bold"
            FontSize="20"
            CornerRadius="10"
            Margin="10"
            Clicked="Button_Clicked"/>
    </VerticalStackLayout>
</ContentPage>