<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">

        <Label Text="SOBRE O APLICATIVO"
               FontSize="33"
               FontFamily="BricolageGrotesque_SemiCondensed - Bold"
                HorizontalOptions="Center"
               TextColor="#D3AF37" />

        <Frame Padding="20" CornerRadius="10" BackgroundColor="White" HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="Desenvolvedor: Victor Vicentini"
                       FontSize="18"
                       TextColor="Black" />
                <Label Text="Ano de Desenvolvimento: 2025"
                       FontSize="18"
                       TextColor="Black" />
                <Label Text="Este aplicativo foi criado para facilitar a contratação de hospedagens em hotéis."
                       FontSize="16"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                BackgroundColor="#D3AF37"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnVoltarClicked" />
    </VerticalStackLayout>
</ContentPage>
